{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "baby_dragon:fireball_glow",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40,
        "max_particles": 80
      },
      "minecraft:emitter_lifetime_looping": { "active_time": 10 },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.25,
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.1, 0.25)"
      },
      "minecraft:particle_initial_speed": { "speed": "math.random(0.3, 1.2)" },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.5,
        "linear_acceleration": [0, 1.0, 0]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.lerp(0.22, 0.0, variable.particle_age / variable.particle_lifetime)",
          "math.lerp(0.22, 0.0, variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [0, 24],
            "size_UV": [8, 8],
            "step_UV": [8, 0],
            "frames_per_second": 12,
            "max_frame": 4,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [1.0, 0.85, 0.2, 1.0],
            "0.3": [1.0, 0.4,  0.0, 0.9],
            "0.7": [0.8, 0.1,  0.0, 0.5],
            "1.0": [0.3, 0.0,  0.0, 0.0]
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
