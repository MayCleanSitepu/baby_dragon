{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "baby_dragon:dragon_fire_charge",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 20 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.35,
        "surface_only": true
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.25, 0.5)"
      },
      "minecraft:particle_initial_speed": { "speed": "math.random(0.3, 1.2)" },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4.0,
        "linear_acceleration": [0, 0.8, 0]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.lerp(0.18, 0.04, variable.particle_age / variable.particle_lifetime)",
          "math.lerp(0.18, 0.04, variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [0, 24],
            "size_UV": [8, 8],
            "step_UV": [8, 0],
            "frames_per_second": 10,
            "max_frame": 4,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [1.0, 0.9, 0.3, 1.0],
            "0.3": [1.0, 0.5, 0.05, 1.0],
            "0.7": [0.9, 0.15, 0.0, 0.7],
            "1.0": [0.4, 0.05, 0.0, 0.0]
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
