{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "dragon:baby_dragon",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "dragon:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:behavior.follow_owner": {
          "priority": 2,
          "speed_multiplier": 1.5,
          "start_distance": 5,
          "stop_distance": 2
        }
      },
      "dragon:just_tamed": {
        "minecraft:variant": { "value": 3 },
        "minecraft:timer": {
          "time": 3.0,
          "looping": false,
          "time_down_event": { "event": "dragon:stop_attack" }
        }
      },
      "dragon:color_0": { "minecraft:skin_id": { "value": 0 } },
      "dragon:color_1": { "minecraft:skin_id": { "value": 1 } },
      "dragon:color_2": { "minecraft:skin_id": { "value": 2 } },
      "dragon:mark_0": { "minecraft:is_dyeable": { "interact_text": "" } },
      "dragon:mark_1": { "minecraft:is_dyeable": { "interact_text": "" } },
      "dragon:mark_2": { "minecraft:is_dyeable": { "interact_text": "" } },
      "dragon:sitting": {
        "minecraft:is_sitting": {},
        "minecraft:variant": { "value": 10 },
        "minecraft:movement": { "value": 0.0 }
      },
      "dragon:dying": {
        "minecraft:variant": { "value": 99 },
        "minecraft:movement": { "value": 0.0 },
        "minecraft:on_target_escape": {
          "event": "dragon:do_nothing",
          "target": "self"
        },
        "minecraft:damage_sensor": {
          "triggers": { "cause": "all", "deals_damage": false }
        },
        "minecraft:timer": {
          "time": 3.5,
          "looping": false,
          "time_down_event": { "event": "dragon:despawn" }
        }
      },
      "dragon:despawning": {
        "minecraft:instant_despawn": {}
      },
      "dragon:attacking": {
        "minecraft:variant": { "value": 1 }
      },
      "dragon:special_attacking": {
        "minecraft:variant": { "value": 2 },
        "minecraft:timer": {
          "time": 3.0,
          "looping": false,
          "time_down_event": { "event": "dragon:stop_attack" }
        }
      },
      "dragon:normal": {
        "minecraft:variant": { "value": 0 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["dragon", "mob"] },
      "minecraft:physics": {},
      "minecraft:collision_box": { "width": 1, "height": 1 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:loot": { "table": "loot_tables/empty.json" },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": true,
            "on_damage": {
              "filters": { "test": "has_health", "operator": "<=", "value": 10 },
              "event": "dragon:start_death"
            }
          }
        ]
      },
      "minecraft:shooter": {
        "def": "baby_dragon:dragon_fireball"
      },
      "minecraft:on_target_acquired": {
        "event": "dragon:start_attack",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "dragon:stop_attack",
        "target": "self"
      },
      "minecraft:ambient_sound_interval": {
        "value": 4.0,
        "range": 8.0,
        "event_name": "baby_dragon.idle"
      },
      "minecraft:attack": {
        "damage": 5
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 25.0,
        "entity_types": [
          {
            "filters": {
              "test": "is_family", "subject": "other", "value": "monster"
            },
            "max_dist": 35
          }
        ]
      },
      "minecraft:behavior.ranged_attack": {
        "priority": 2,
        "attack_interval_min": 2,
        "attack_interval_max": 4,
        "attack_radius": 20,
        "charge_shoot_trigger": 0.4
      },
      "minecraft:movement": { "value": 0.2 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true
      },
      "minecraft:behavior.float": { "priority": 5 },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.tempt": {
        "priority": 7,
        "speed_multiplier": 1.25,
        "items": ["carrot", "apple"]
      },
      "minecraft:skin_id": { "value": 0 },
      "minecraft:variant": { "value": 0 },
      "minecraft:tameable": {
        "probability": 1.0,
        "tame_items": ["carrot"],
        "tame_event": { "event": "dragon:on_tame" }
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "minecraft:feather" },
              "event": "dragon:cycle_color"
            },
            "play_sounds": "random.pop",
            "interact_text": "Change Color"
          },
          {
            "on_interact": {
              "filters": { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "minecraft:apple" },
              "event": "dragon:start_attack"
            },
            "play_sounds": "mob.enderdragon.growl",
            "interact_text": "Test Attack"
          },
          {
            "on_interact": {
              "filters": { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "minecraft:glass_bottle" },
              "event": "dragon:start_special_attack"
            },
            "play_sounds": "mob.enderdragon.death",
            "interact_text": "Test Special"
          },
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "minecraft:stick" },
                  { "test": "is_variant", "operator": "!=", "value": 10 }
                ]
              },
              "event": "dragon:sit"
            },
            "interact_text": "Sit"
          },
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "minecraft:stick" },
                  { "test": "is_variant", "value": 10 }
                ]
              },
              "event": "dragon:stand"
            },
            "interact_text": "Stand"
          }
        ]
      }
    },
    "events": {
      "dragon:on_tame": {
        "add": { "component_groups": ["dragon:tamed", "dragon:just_tamed"] },
        "remove": { "component_groups": ["dragon:normal"] }
      },
      "dragon:start_attack": {
        "add": { "component_groups": ["dragon:attacking"] },
        "remove": { "component_groups": ["dragon:normal", "dragon:special_attacking", "dragon:just_tamed"] }
      },
      "dragon:start_special_attack": {
        "add": { "component_groups": ["dragon:special_attacking"] },
        "remove": { "component_groups": ["dragon:normal", "dragon:attacking", "dragon:just_tamed"] }
      },
      "dragon:stop_attack": {
        "add": { "component_groups": ["dragon:normal"] },
        "remove": { "component_groups": ["dragon:attacking", "dragon:special_attacking", "dragon:just_tamed"] }
      },
      "dragon:sit": {
        "add": { "component_groups": ["dragon:sitting"] },
        "remove": { "component_groups": ["dragon:normal"] }
      },
      "dragon:stand": {
        "add": { "component_groups": ["dragon:normal"] },
        "remove": { "component_groups": ["dragon:sitting"] }
      },
      "dragon:start_death": {
        "add": { "component_groups": ["dragon:dying"] },
        "remove": { "component_groups": ["dragon:normal", "dragon:attacking", "dragon:special_attacking", "dragon:sitting", "dragon:just_tamed"] }
      },
      "dragon:do_nothing": {},
      "dragon:cycle_color": {
        "randomize": [
          {
            "weight": 1,
            "add": { "component_groups": ["dragon:color_0"] },
            "remove": { "component_groups": ["dragon:color_1", "dragon:color_2"] }
          },
          {
            "weight": 1,
            "add": { "component_groups": ["dragon:color_1"] },
            "remove": { "component_groups": ["dragon:color_0", "dragon:color_2"] }
          },
          {
            "weight": 1,
            "add": { "component_groups": ["dragon:color_2"] },
            "remove": { "component_groups": ["dragon:color_0", "dragon:color_1"] }
          }
        ]
      },
      "dragon:despawn": {
        "add": { "component_groups": ["dragon:despawning"] }
      }
    }
  }
}
